<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mailing.import</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mass_mailing.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='managa_mail_campaigns_setting_container']"
                position="inside"
            >
                <setting
                    id="mailing_import_type"
                    string="Default Mailing Import Type"
                    help="Select the default import type for mailing contacts."
                >
                    <field name="mailing_import_type" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
